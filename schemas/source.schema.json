{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samuged.local/schema/source.schema.json",
  "title": "SaMuGeD source manifest row",
  "type": "object",
  "$defs": {
    "hex24": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativeMidiPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.[mM][iI][dD][iI]?$"
    },
    "relativeExportPath": {
      "type": "string",
      "pattern": "^midi/(?:melodic|percussion)/[0-9a-f]{32}\\.mid$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "integerArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonNegativeInteger"
      }
    },
    "scoreComponents": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/nonNegativeNumber"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "occurrence": {
      "type": "object",
      "properties": {
        "start_tick": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "end_tick": {
          "$ref": "#/$defs/positiveInteger"
        },
        "note_index": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "similarity": {
          "$ref": "#/$defs/score"
        },
        "transpose_semitones": {
          "type": "integer"
        },
        "note_count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "matched_pairs": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "#/$defs/nonNegativeInteger"
              },
              {
                "$ref": "#/$defs/nonNegativeInteger"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "matched_note_pairs": {
          "$ref": "#/$defs/pairArray"
        },
        "edit_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "inserted_note_indices": {
          "$ref": "#/$defs/integerArray"
        },
        "deleted_prototype_note_indices": {
          "$ref": "#/$defs/integerArray"
        },
        "substituted_note_pairs": {
          "$ref": "#/$defs/pairArray"
        },
        "max_timing_error_beats": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "max_duration_error_beats": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "source_verified": {
          "type": "boolean"
        }
      },
      "required": [
        "start_tick",
        "end_tick",
        "similarity",
        "transpose_semitones"
      ],
      "additionalProperties": false
    },
    "phrase": {
      "type": "object",
      "properties": {
        "bar_count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "duration_beats": {
          "$ref": "#/$defs/positiveNumber"
        },
        "duration_policy": {
          "type": "string",
          "minLength": 1
        },
        "durations_beats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/positiveNumber"
          },
          "minItems": 1
        },
        "end_tick": {
          "$ref": "#/$defs/positiveInteger"
        },
        "family_id": {
          "$ref": "#/$defs/hex64"
        },
        "kind": {
          "enum": [
            "melodic",
            "percussion"
          ]
        },
        "kit_programs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "minItems": 1
        },
        "meter_denominator": {
          "$ref": "#/$defs/positiveInteger"
        },
        "meter_numerator": {
          "$ref": "#/$defs/positiveInteger"
        },
        "midi_path": {
          "$ref": "#/$defs/relativeExportPath"
        },
        "midi_sha256": {
          "$ref": "#/$defs/hex64"
        },
        "note_count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "occurrence_count": {
          "type": "integer",
          "minimum": 2
        },
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/occurrence"
          },
          "minItems": 2
        },
        "onsets_beats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonNegativeNumber"
          },
          "minItems": 1
        },
        "part_index": {
          "type": "integer",
          "minimum": -1
        },
        "part_name": {
          "type": "string"
        },
        "phrase_id": {
          "$ref": "#/$defs/hex32"
        },
        "pitches": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "minItems": 1
        },
        "program": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "prototype_note_index": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "rank_in_file": {
          "$ref": "#/$defs/positiveInteger"
        },
        "raw_occurrence_count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "recurrence_score": {
          "$ref": "#/$defs/score"
        },
        "score_components": {
          "$ref": "#/$defs/scoreComponents"
        },
        "source_part_indices": {
          "$ref": "#/$defs/integerArray"
        },
        "source_track": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "source_tracks": {
          "$ref": "#/$defs/integerArray"
        },
        "start_tick": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "velocities": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "minItems": 1
        },
        "matcher_flags": {
          "$ref": "#/$defs/matcherFlags"
        }
      },
      "required": [
        "channel",
        "duration_beats",
        "durations_beats",
        "end_tick",
        "family_id",
        "kind",
        "note_count",
        "occurrence_count",
        "occurrences",
        "onsets_beats",
        "part_index",
        "phrase_id",
        "pitches",
        "rank_in_file",
        "recurrence_score",
        "score_components",
        "start_tick",
        "velocities"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "midi_path"
            ]
          },
          "then": {
            "required": [
              "midi_sha256"
            ]
          }
        },
        {
          "if": {
            "required": [
              "midi_sha256"
            ]
          },
          "then": {
            "required": [
              "midi_path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "melodic"
              }
            }
          },
          "then": {
            "properties": {
              "occurrences": {
                "items": {
                  "required": [
                    "note_index"
                  ]
                }
              }
            },
            "required": [
              "part_name",
              "program",
              "prototype_note_index",
              "raw_occurrence_count",
              "source_track"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "percussion"
              }
            }
          },
          "then": {
            "properties": {
              "channel": {
                "const": 9
              },
              "part_index": {
                "const": -1
              },
              "occurrences": {
                "items": {
                  "properties": {
                    "transpose_semitones": {
                      "const": 0
                    }
                  }
                }
              }
            },
            "required": [
              "bar_count",
              "duration_policy",
              "kit_programs",
              "meter_denominator",
              "meter_numerator",
              "source_part_indices",
              "source_tracks"
            ]
          }
        },
        {
          "if": {
            "required": [
              "matcher_flags"
            ]
          },
          "then": {
            "properties": {
              "occurrences": {
                "items": {
                  "required": [
                    "note_index",
                    "note_count",
                    "edit_count",
                    "inserted_note_indices",
                    "deleted_prototype_note_indices",
                    "substituted_note_pairs",
                    "matched_note_pairs",
                    "max_timing_error_beats",
                    "max_duration_error_beats",
                    "source_verified"
                  ]
                }
              }
            },
            "required": [
              "matcher_flags"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "pairArray": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "$ref": "#/$defs/nonNegativeInteger"
          },
          {
            "$ref": "#/$defs/nonNegativeInteger"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "matcherFlags": {
      "type": "object",
      "properties": {
        "source_verified": {
          "type": "boolean"
        },
        "monotone_alignment": {
          "type": "boolean"
        },
        "fixed_transposition": {
          "type": "boolean"
        },
        "tempo_warp": {
          "type": "boolean"
        },
        "terminal_gaps_allowed": {
          "type": "boolean"
        },
        "similarity_only_acceptance": {
          "type": "boolean"
        }
      },
      "required": [
        "source_verified",
        "monotone_alignment",
        "fixed_transposition",
        "tempo_warp",
        "terminal_gaps_allowed",
        "similarity_only_acceptance"
      ],
      "additionalProperties": false
    },
    "metadataRepair": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "invalid_key_signature_retyped_as_sequencer_specific"
        },
        "track_index": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "event_index": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "tick": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "offset_basis": {
          "const": "unwrapped_smf_bytes"
        },
        "event_offset": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "status_offset": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "meta_type_offset": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "payload_offset": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "original_meta_type": {
          "const": 89
        },
        "replacement_meta_type": {
          "const": 127
        },
        "original_payload_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})+$",
          "minLength": 4,
          "maxLength": 33554432
        },
        "reason": {
          "enum": [
            "signed_key_out_of_range",
            "mode_not_major_or_minor",
            "signed_key_out_of_range+mode_not_major_or_minor"
          ]
        },
        "original_smf_sha256": {
          "$ref": "#/$defs/hex64"
        },
        "recovered_smf_sha256": {
          "$ref": "#/$defs/hex64"
        }
      },
      "required": [
        "kind",
        "track_index",
        "event_index",
        "tick",
        "offset_basis",
        "event_offset",
        "status_offset",
        "meta_type_offset",
        "payload_offset",
        "original_meta_type",
        "replacement_meta_type",
        "original_payload_hex",
        "reason",
        "original_smf_sha256",
        "recovered_smf_sha256"
      ],
      "additionalProperties": false
    },
    "saturatedSeedKeyTypes": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "single",
          "pair"
        ]
      },
      "properties": {
        "single": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "pair": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      },
      "maxProperties": 2,
      "additionalProperties": false
    }
  },
  "properties": {
    "artist_from_path": {
      "type": "string",
      "minLength": 1
    },
    "artist_key": {
      "type": "string",
      "minLength": 1
    },
    "candidate_count": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "config": {
      "type": "object",
      "properties": {
        "duration_error_fraction": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "duration_tolerance": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "lengths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 4,
            "maximum": 128
          },
          "minItems": 1,
          "maxItems": 24
        },
        "max_beats": {
          "$ref": "#/$defs/positiveNumber"
        },
        "max_bucket": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_candidates": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_comparisons": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_gap_beats": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "max_stream_notes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_windows": {
          "$ref": "#/$defs/positiveInteger"
        },
        "min_beats": {
          "$ref": "#/$defs/positiveNumber"
        },
        "mode": {
          "enum": [
            "exact",
            "transposed",
            "approximate"
          ]
        },
        "onset_merge_beats": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "pitch_error_fraction": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "timing_tolerance": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "top_k": {
          "$ref": "#/$defs/positiveInteger"
        },
        "min_notes": {
          "type": "integer",
          "minimum": 4,
          "maximum": 128
        },
        "max_notes": {
          "type": "integer",
          "minimum": 4,
          "maximum": 128
        },
        "max_edit_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.15
        },
        "max_edits": {
          "$ref": "#/$defs/nonNegativeInteger",
          "maximum": 16
        },
        "seed_notes": {
          "type": "integer",
          "minimum": 3,
          "maximum": 5
        },
        "seed_beat_bucket": {
          "$ref": "#/$defs/positiveNumber"
        },
        "span_beat_bucket": {
          "$ref": "#/$defs/positiveNumber"
        },
        "max_seed_offsets": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_seed_pairs": {
          "$ref": "#/$defs/positiveInteger"
        },
        "min_seed_support": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_shift_candidates": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_groups": {
          "$ref": "#/$defs/positiveInteger"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "duration_error_fraction",
            "duration_tolerance",
            "lengths",
            "max_beats",
            "max_bucket",
            "max_candidates",
            "max_comparisons",
            "max_gap_beats",
            "max_stream_notes",
            "max_windows",
            "min_beats",
            "mode",
            "onset_merge_beats",
            "pitch_error_fraction",
            "timing_tolerance",
            "top_k"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "min_notes"
                ]
              },
              {
                "required": [
                  "max_notes"
                ]
              },
              {
                "required": [
                  "max_edit_fraction"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "duration_error_fraction",
            "duration_tolerance",
            "max_beats",
            "max_bucket",
            "max_candidates",
            "max_comparisons",
            "max_edit_fraction",
            "max_edits",
            "max_gap_beats",
            "max_groups",
            "max_notes",
            "max_seed_offsets",
            "max_seed_pairs",
            "max_shift_candidates",
            "max_stream_notes",
            "max_windows",
            "min_beats",
            "min_notes",
            "min_seed_support",
            "onset_merge_beats",
            "seed_beat_bucket",
            "seed_notes",
            "span_beat_bucket",
            "timing_tolerance",
            "top_k"
          ],
          "not": {
            "required": [
              "mode"
            ]
          }
        }
      ]
    },
    "curation_truncated": {
      "type": "boolean"
    },
    "drum_stats": {
      "type": "object",
      "properties": {
        "bar_origin_assumption": {
          "type": "string",
          "minLength": 1
        },
        "candidate_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "candidate_limit_reached": {
          "type": "boolean"
        },
        "candidates_truncated": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "comparison_limit_reached": {
          "type": "boolean"
        },
        "comparisons": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "config": {
          "type": "object",
          "properties": {
            "bar_counts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/positiveInteger"
              },
              "minItems": 1
            },
            "hit_error_fraction": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "max_bucket": {
              "$ref": "#/$defs/positiveInteger"
            },
            "max_candidates": {
              "$ref": "#/$defs/positiveInteger"
            },
            "max_comparisons": {
              "$ref": "#/$defs/positiveInteger"
            },
            "max_hits": {
              "$ref": "#/$defs/positiveInteger"
            },
            "max_window_hits": {
              "$ref": "#/$defs/positiveInteger"
            },
            "max_windows": {
              "$ref": "#/$defs/positiveInteger"
            },
            "min_hits": {
              "$ref": "#/$defs/positiveInteger"
            },
            "min_pitches": {
              "$ref": "#/$defs/positiveInteger"
            },
            "mode": {
              "type": "string",
              "minLength": 1
            },
            "timing_tolerance_beats": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "top_k": {
              "$ref": "#/$defs/positiveInteger"
            }
          },
          "required": [
            "bar_counts",
            "hit_error_fraction",
            "max_bucket",
            "max_candidates",
            "max_comparisons",
            "max_hits",
            "max_window_hits",
            "max_windows",
            "min_hits",
            "min_pitches",
            "mode",
            "timing_tolerance_beats",
            "top_k"
          ],
          "additionalProperties": false
        },
        "diversity_comparisons": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "diversity_pruned": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "duplicate_hits_removed": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "eligible_windows": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hit_limit_reached": {
          "type": "boolean"
        },
        "input_drum_parts": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "input_hits": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "kit_programs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          }
        },
        "merged_hits": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "meter_segments": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "oversized_windows": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "raw_candidate_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "raw_group_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "saturated_seed_buckets": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "search_limited": {
          "type": "boolean"
        },
        "selected_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "source_part_indices": {
          "$ref": "#/$defs/integerArray"
        },
        "source_tracks": {
          "$ref": "#/$defs/integerArray"
        },
        "window_attempts": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "window_limit_reached": {
          "type": "boolean"
        },
        "windows_considered": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      },
      "required": [
        "bar_origin_assumption",
        "candidate_count",
        "candidate_limit_reached",
        "candidates_truncated",
        "comparison_limit_reached",
        "comparisons",
        "config",
        "diversity_comparisons",
        "diversity_pruned",
        "duplicate_hits_removed",
        "eligible_windows",
        "hit_limit_reached",
        "input_drum_parts",
        "input_hits",
        "kit_programs",
        "merged_hits",
        "meter_segments",
        "mode",
        "oversized_windows",
        "raw_candidate_count",
        "raw_group_count",
        "saturated_seed_buckets",
        "search_limited",
        "selected_count",
        "source_part_indices",
        "source_tracks",
        "window_attempts",
        "window_limit_reached",
        "windows_considered"
      ],
      "additionalProperties": false
    },
    "elapsed_seconds": {
      "$ref": "#/$defs/nonNegativeNumber"
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "error_type": {
      "type": "string",
      "minLength": 1
    },
    "index_variant": {
      "const": "exact_first_cached_v1"
